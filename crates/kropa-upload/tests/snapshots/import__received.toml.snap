---
source: crates/kropa-upload/tests/import.rs
expression: text
---
origin: https://img.received.example:443 (host img.received.example, https true)

--- profile ---
[[destination]]
id = "received"
type = "http"
label = "Received"
kinds = ["image", "file"]

[destination.request]
method = "POST"
url = "https://img.received.example/api/upload"
body = "multipart"
redirects = "same-origin"

[destination.request.query]
visibility = "{secret:visibility}"

[destination.request.headers]
Accept = "application/json"
Authorization = "Bearer {secret:authorization}"
X-Signature = "{secret:sig}"

[destination.request.fields]
album = "{var:album}"
title = "{filename}"

[destination.secrets.authorization]

[destination.secrets.sig]

[destination.secrets.visibility]

[destination.vars.album]
default = "inbox"

[destination.response]
url = "{json:$.data.url}"

--- secrets ---
authorization | Header("Authorization") | header:authorization | https://img.received.example:443 | ***cdef | value
sig | Header("X-Signature") | header:x-signature | https://img.received.example:443 | (to be entered) | to enter
visibility | Query("visibility") | query:visibility | https://img.received.example:443 | ***ed | value

--- notes ---
query_secret: visibility
