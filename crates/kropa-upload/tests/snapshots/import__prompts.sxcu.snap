---
source: crates/kropa-upload/tests/import.rs
expression: text
---
origin: https://gallery.example.org:443 (host gallery.example.org, https true)

--- profile ---
[[destination]]
id = "gallery-with-prompts"
type = "http"
label = "Gallery with prompts"
kinds = ["image"]

[destination.request]
method = "POST"
url = "https://gallery.example.org/api/v2/images"
body = "multipart"
file_field = "file"
redirects = "same-origin"

[destination.request.headers]
Authorization = "Bearer {secret:authorization}"
X-Album = "{var:x_album}"

[destination.request.fields]
album = "{var:album}"
caption = "{var:caption}"

[destination.secrets.authorization]

[destination.vars.album]
default = "Holidays"
choices = ["Holidays", "Work", "Family"]

[destination.vars.caption]
prompt = "Caption"
default = "Screenshot"

[destination.vars.x_album]
default = "Holidays"
choices = ["Holidays", "Work", "Family"]

[destination.response]
url = "{json:link}"

--- secrets ---
authorization | Header("Authorization") | header:authorization | https://gallery.example.org:443 | (to be entered) | to enter

--- notes ---
