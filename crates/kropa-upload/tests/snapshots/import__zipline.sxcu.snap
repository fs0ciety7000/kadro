---
source: crates/kropa-upload/tests/import.rs
expression: text
---
origin: https://zipline.example.org:443 (host zipline.example.org, https true)

--- profile ---
[[destination]]
id = "zipline-team"
type = "http"
label = "Zipline (team)"
kinds = ["image", "file"]

[destination.request]
method = "POST"
url = "https://zipline.example.org/api/upload"
body = "multipart"
file_field = "file"
redirects = "same-origin"

[destination.request.headers]
Accept = "application/json"
Authorization = "{secret:authorization}"
x-zipline-format = "random"
x-zipline-original-name = "false"

[destination.secrets.authorization]

[destination.response]
url = "{json:files[0].url}"
error = "{json:error}"

--- secrets ---
authorization | Header("Authorization") | header:authorization | https://zipline.example.org:443 | ***cdef | value

--- notes ---
text_types_ignored: TextUploader
