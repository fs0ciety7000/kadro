---
source: crates/kropa-upload/tests/import.rs
expression: text
---
origin: https://api.imgur.com:443 (host api.imgur.com, https true)

--- profile ---
[[destination]]
id = "imgur-anonymous"
type = "http"
label = "Imgur (anonymous)"
kinds = ["image"]

[destination.request]
method = "POST"
url = "https://api.imgur.com/3/image"
body = "multipart"
file_field = "image"
redirects = "same-origin"

[destination.request.headers]
Authorization = "{secret:authorization}"

[destination.secrets.authorization]

[destination.response]
url = "{json:data.link}"
deletion_url = "https://imgur.com/delete/{json:data.deletehash}"
error = "{json:data.error}"

--- secrets ---
authorization | Header("Authorization") | header:authorization | https://api.imgur.com:443 | ***bcde | value

--- notes ---
